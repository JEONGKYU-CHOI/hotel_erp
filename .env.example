# docker-compose 배포용 환경변수 템플릿.
#   cp .env.example .env  후 실제 값으로 채운다. .env 는 커밋하지 않는다(.gitignore).
#
# ── 필수 ──────────────────────────────────────────────────────────────────
# MySQL root 비밀번호 (컨테이너 DB). 아무 강한 값이나.
DB_PASSWORD=change-me-strong-db-password

# JWT 서명 키. HS256 이므로 최소 32바이트(영문 32자 이상) 이상이어야 한다.
JWT_SECRET=change-me-please-use-at-least-32-bytes-secret-key

# 백오피스(/admin) 초기 관리자 계정.
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=change-me-strong-admin-password

# ── 토스페이먼츠 (결제 시연 시) ────────────────────────────────────────────
#   테스트 키로도 결제 흐름 시연이 된다. 실 승인은 실 키 필요.
#   https://developers.tosspayments.com 콘솔에서 발급.
TOSS_SECRET_KEY=test_sk_your_test_secret_key
TOSS_CLIENT_KEY=test_ck_your_test_client_key
